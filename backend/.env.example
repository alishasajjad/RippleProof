# =========================================================
# Database
# =========================================================

DATABASE_URL=postgresql+psycopg://rippleproof:rippleproof@127.0.0.1:5435/rippleproof


# =========================================================
# AI
# =========================================================

LLM_PROVIDER=groq

LLM_BASE_URL=https://api.groq.com/openai/v1

LLM_MODEL=openai/gpt-oss-20b

GROQ_API_KEY=your_key_here


# auto:
# use Groq when available,
# deterministic fallback if unavailable.
LLM_MODE=auto


# =========================================================
# Security / API
# =========================================================

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ANALYSIS_RATE_LIMIT_PER_MINUTE=8


# =========================================================
# Upload safety
# =========================================================

MAX_UPLOAD_FILES=10

MAX_UPLOAD_FILE_BYTES=2097152

MAX_TOTAL_UPLOAD_BYTES=10485760

# Authentication
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_HOURS=12

# Optional SMTP alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Current Groq provider
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/
GROQ_MODEL=openai/gpt-oss-20b

# Optional secondary OpenAI-compatible provider
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=